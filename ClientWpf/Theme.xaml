<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Palette (Sprout) ===== -->
  <Color x:Key="ForestDeepColor">#FF072906</Color>
  <Color x:Key="ForestColor">#FF0A400C</Color>
  <Color x:Key="SageColor">#FF819067</Color>
  <Color x:Key="OliveColor">#FFB1AB86</Color>
  <Color x:Key="CreamColor">#FFFEFAE0</Color>
  <Color x:Key="BgWarmColor">#FFF6F2E2</Color>
  <Color x:Key="InkColor">#FF1B2A1C</Color>
  <Color x:Key="InkSoftColor">#FF506450</Color>
  <Color x:Key="SoftGreenColor">#FF9CC97A</Color>
  <Color x:Key="SoftGreenBgColor">#FFD9F0BC</Color>
  <Color x:Key="OnlineColor">#FF5BAA45</Color>
  <Color x:Key="DangerColor">#FFB43A2E</Color>

  <SolidColorBrush x:Key="ForestDeep"  Color="{StaticResource ForestDeepColor}"/>
  <SolidColorBrush x:Key="Forest"      Color="{StaticResource ForestColor}"/>
  <SolidColorBrush x:Key="Sage"        Color="{StaticResource SageColor}"/>
  <SolidColorBrush x:Key="Olive"       Color="{StaticResource OliveColor}"/>
  <SolidColorBrush x:Key="Cream"       Color="{StaticResource CreamColor}"/>
  <SolidColorBrush x:Key="BgWarm"      Color="{StaticResource BgWarmColor}"/>
  <SolidColorBrush x:Key="Ink"         Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="InkSoft"     Color="{StaticResource InkSoftColor}"/>
  <SolidColorBrush x:Key="SoftGreen"   Color="{StaticResource SoftGreenColor}"/>
  <SolidColorBrush x:Key="SoftGreenBg" Color="{StaticResource SoftGreenBgColor}"/>
  <SolidColorBrush x:Key="Online"      Color="{StaticResource OnlineColor}"/>
  <SolidColorBrush x:Key="Danger"      Color="{StaticResource DangerColor}"/>

  <SolidColorBrush x:Key="Hairline"      Color="#220A400C"/>
  <SolidColorBrush x:Key="HairlineCream" Color="#22FEFAE0"/>
  <SolidColorBrush x:Key="CreamSoft"     Color="#14FEFAE0"/>
  <SolidColorBrush x:Key="CreamSofter"   Color="#08FEFAE0"/>
  <SolidColorBrush x:Key="SidebarSearchBg" Color="#FF1C3C1A"/>

  <!-- forest -> deeper gradient backdrop -->
  <LinearGradientBrush x:Key="BackdropGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0"   Color="#FF1F2D20"/>
    <GradientStop Offset="0.6" Color="#FF0E1A0E"/>
    <GradientStop Offset="1"   Color="#FF050A05"/>
  </LinearGradientBrush>

  <!-- ===== Typography ===== -->
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Calibri</FontFamily>
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, Calibri</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Menlo</FontFamily>

  <!-- ===== Shadow presets ===== -->
  <DropShadowEffect x:Key="ShadowSmall" BlurRadius="14" ShadowDepth="3" Direction="270"
                    Color="#FF0A400C" Opacity="0.18" RenderingBias="Quality"/>
  <DropShadowEffect x:Key="ShadowCard" BlurRadius="40" ShadowDepth="10" Direction="270"
                    Color="#FF0A400C" Opacity="0.25" RenderingBias="Quality"/>
  <DropShadowEffect x:Key="ShadowButton" BlurRadius="16" ShadowDepth="4" Direction="270"
                    Color="#FF0A400C" Opacity="0.35" RenderingBias="Quality"/>

</ResourceDictionary>
