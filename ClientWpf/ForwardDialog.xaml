<Window x:Class="ChatApp.ClientWpf.ForwardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Переслать сообщение"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
  <Border CornerRadius="16" Background="{StaticResource BgWarm}"
          BorderBrush="{StaticResource Hairline}" BorderThickness="1"
          Effect="{StaticResource ShadowCard}" Margin="12">
    <DockPanel>
      <!-- Шапка в цветах приложения -->
      <Border DockPanel.Dock="Top" Background="{StaticResource ForestDeep}"
              CornerRadius="15,15,0,0" Padding="18,12"
              MouseLeftButtonDown="OnDragWindow">
        <Grid>
          <TextBlock Text="Переслать сообщение"
                     FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                     FontSize="13" Foreground="{StaticResource Cream}"
                     VerticalAlignment="Center"/>
          <Button Content="✕" Click="OnCloseDialog"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#AAFEFAE0" FontSize="14" Cursor="Hand"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Padding="6,2"/>
        </Grid>
      </Border>

      <!-- Контент -->
      <StackPanel Margin="24,18,24,24">
        <TextBlock Text="Переслать сообщение"
                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                   FontSize="20" Foreground="{StaticResource Forest}"/>
        <TextBlock Text="Выберите чат для пересылки."
                   Foreground="{StaticResource InkSoft}" FontSize="12.5"
                   Margin="0,6,0,12"/>

        <Border BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                CornerRadius="14" Background="White" Height="170">
          <ListBox x:Name="RoomList"
                   Background="Transparent" BorderThickness="0"
                   Padding="4,4"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="bg" Background="{TemplateBinding Background}"
                              CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bg" Property="Background" Value="{StaticResource SoftGreenBg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="bg" Property="Background" Value="{StaticResource SoftGreenBg}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="13.5" Foreground="{StaticResource Ink}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button Content="Отмена" Style="{StaticResource PillowGhost}" Height="44" Padding="22,0"
                  IsCancel="True" Margin="0,0,8,0" Click="OnCloseDialog"/>
          <Button Content="Переслать" Style="{StaticResource PillowPrimary}" Height="44" Padding="24,0"
                  IsDefault="True" Click="OnOk"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
