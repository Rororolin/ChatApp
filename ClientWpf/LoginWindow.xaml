<Window x:Class="ChatApp.ClientWpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatApp.ClientWpf"
        Title="Sprout — вход"
        Width="1000" Height="700"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ForestDeep}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
  <Window.Resources>
    <local:BoolToVisibilityConverter x:Key="b2v"/>
  </Window.Resources>
  <Grid>
    <!-- Backdrop gradient + speckles -->
    <Rectangle Fill="{StaticResource BackdropGradient}"/>
    <Canvas x:Name="SpeckleCanvas" IsHitTestVisible="False" Opacity="0.5"/>

    <Grid Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="460"/>
      </Grid.ColumnDefinitions>

      <!-- Left: brand block -->
      <StackPanel Grid.Column="0" Margin="64,72,40,40" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border CornerRadius="14" Width="48" Height="48"
                  Background="{StaticResource SoftGreenBg}"
                  Padding="10" VerticalAlignment="Center">
            <Path Data="{StaticResource SproutLeafGeom}" Stroke="{StaticResource Forest}"
                  StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Sprout"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="34" FontWeight="Bold"
                     Foreground="{StaticResource Cream}"
                     Margin="14,0,12,0" VerticalAlignment="Center"/>
          <Border CornerRadius="6" Background="#26FEFAE0" Padding="8,3"
                  BorderBrush="#5C9CC97A" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock Text="E2EE" Foreground="{StaticResource SoftGreen}"
                       FontFamily="{StaticResource DisplayFont}"
                       FontWeight="Bold" FontSize="11"/>
          </Border>
        </StackPanel>

        <TextBlock FontFamily="{StaticResource DisplayFont}"
                   Foreground="{StaticResource Cream}"
                   FontSize="44" FontWeight="Bold"
                   LineHeight="48"
                   Margin="0,46,0,0">
          <Run Text="Stay rooted."/><LineBreak/>
          <Run Text="Grow gently."/>
        </TextBlock>

      </StackPanel>

      <!-- Right: cream card -->
      <Border Grid.Column="1" Margin="0,40,40,40"
              CornerRadius="28"
              Background="{StaticResource BgWarm}"
              BorderBrush="#22FEFAE0" BorderThickness="1"
              Effect="{StaticResource ShadowCard}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
          <StackPanel Margin="32,28,32,28">

            <TextBlock Text="С возвращением."
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource Forest}"/>
            <TextBlock Text="Войдите в учётную запись или создайте новую."
                       Foreground="{StaticResource InkSoft}" FontSize="13"
                       Margin="0,4,0,0"/>

            <!-- Segmented toggle: Login / Register -->
            <Border CornerRadius="22" Background="#FF0A400C" Padding="4" Margin="0,18,0,0">
              <Grid Height="40">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="RbLogin" Grid.Column="0"
                             Content="Войти" IsChecked="True"
                             Style="{StaticResource PillToggle}"
                             Checked="OnModeChanged"/>
                <RadioButton x:Name="RbRegister" Grid.Column="1"
                             Content="Регистрация"
                             Style="{StaticResource PillToggle}"
                             Checked="OnModeChanged"/>
              </Grid>
            </Border>

            <!-- Fields -->
            <TextBlock Text="СЕРВЕР" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TbIp"   Grid.Column="0" Style="{StaticResource CreamTextBox}" Tag="127.0.0.1 / mychat.example.com" Text="127.0.0.1" Margin="0,0,8,0"/>
              <TextBox x:Name="TbPort" Grid.Column="1" Style="{StaticResource CreamTextBox}" Tag="порт"     Text="5000"/>
            </Grid>

            <StackPanel x:Name="DisplayPanel" Visibility="Collapsed">
              <TextBlock Text="ИМЯ (КАК ВАС ВИДЯТ)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
              <TextBox x:Name="TbDisplay" Style="{StaticResource CreamTextBox}" Tag="Анна, Виктор, Foo Bar"/>
            </StackPanel>

            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
            <TextBox x:Name="TbUser" Style="{StaticResource CreamTextBox}" Tag="a–z, цифры, _, 2–20 символов"/>

            <TextBlock Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
            <PasswordBox x:Name="PbPassword" Style="{StaticResource CreamPasswordBox}"/>

            <TextBlock x:Name="PassRules"
                       Foreground="{StaticResource Sage}"
                       FontSize="11.5" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock x:Name="StatusLabel"
                       Foreground="{StaticResource Danger}"
                       FontWeight="SemiBold" FontSize="12.5"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>

            <Button x:Name="BtnConnect"
                    Content="Подключиться  →"
                    Style="{StaticResource PillowPrimary}"
                    Height="48" Margin="0,16,0,0"
                    Click="OnConnect"
                    IsDefault="True"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
