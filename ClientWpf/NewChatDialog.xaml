<Window x:Class="ChatApp.ClientWpf.NewChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatApp.ClientWpf"
        Title="Новый чат"
        Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="{StaticResource BgWarm}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
  <Grid Margin="28,22,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Новый чат"
               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
               FontSize="22" Foreground="{StaticResource Forest}"/>

    <!-- Mode pill -->
    <Border Grid.Row="1" Margin="0,16,0,16" CornerRadius="22"
            Background="#1A0A400C" BorderBrush="#260A400C" BorderThickness="1"
            Padding="4" Height="44">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <RadioButton x:Name="RbDm"  Grid.Column="0" Content="Личный" IsChecked="True"
                     Style="{StaticResource PillToggleCream}" Checked="OnModeChanged"/>
        <RadioButton x:Name="RbGrp" Grid.Column="1" Content="Группа"
                     Style="{StaticResource PillToggleCream}" Checked="OnModeChanged"/>
      </Grid>
    </Border>

    <!-- Direct -->
    <StackPanel x:Name="DmPanel" Grid.Row="2">
      <TextBlock Text="USERNAME СОБЕСЕДНИКА" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
      <TextBox x:Name="TbDm" Style="{StaticResource CreamTextBox}" Tag="@alice"/>
    </StackPanel>

    <!-- Group -->
    <StackPanel x:Name="GrpPanel" Grid.Row="2" Visibility="Collapsed">
      <TextBlock Text="НАЗВАНИЕ ГРУППЫ (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
      <TextBox x:Name="TbName" Style="{StaticResource CreamTextBox}" Tag="Дизайн-команда"/>
    </StackPanel>

    <!-- Footnote -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Top">
      <Path Data="{StaticResource LockGlyph}" Stretch="Uniform"
            Width="11" Height="11" Fill="{StaticResource Sage}"
            VerticalAlignment="Center"/>
      <TextBlock Text="Новый чат будет автоматически зашифрован end-to-end."
                 Foreground="{StaticResource Sage}" FontSize="12"
                 Margin="6,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button Content="Отмена"
              Style="{StaticResource PillowGhost}" Height="44" Padding="22,0"
              IsCancel="True"
              Margin="0,0,8,0"/>
      <Button x:Name="BtnCreate"
              Content="Создать  →"
              Style="{StaticResource PillowPrimary}" Height="44" Padding="24,0"
              IsDefault="True"
              Click="OnCreate"/>
    </StackPanel>
  </Grid>
</Window>
