<Window x:Class="ChatApp.ClientWpf.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Сообщение"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
  <Border CornerRadius="16" Background="{StaticResource BgWarm}"
          BorderBrush="{StaticResource Hairline}" BorderThickness="1"
          Effect="{StaticResource ShadowCard}" Margin="12">
    <DockPanel>
      <!-- Шапка -->
      <Border DockPanel.Dock="Top" Background="{StaticResource ForestDeep}"
              CornerRadius="15,15,0,0" Padding="18,12"
              MouseLeftButtonDown="OnDragWindow">
        <Grid>
          <TextBlock x:Name="TbTitle"
                     FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                     FontSize="13" Foreground="{StaticResource Cream}"
                     VerticalAlignment="Center"/>
          <Button Content="✕" Click="OnOk"
                  Background="Transparent" BorderThickness="0"
                  Foreground="#AAFEFAE0" FontSize="14" Cursor="Hand"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Padding="6,2"/>
        </Grid>
      </Border>

      <!-- Контент -->
      <StackPanel Margin="28,22,28,26">
        <TextBlock x:Name="TbBody"
                   Foreground="{StaticResource InkSoft}" FontSize="13"
                   TextWrapping="Wrap"/>
        <Button Content="ОК" Style="{StaticResource PillowPrimary}" Height="44" Padding="32,0"
                HorizontalAlignment="Right" Margin="0,20,0,0"
                IsDefault="True" IsCancel="True" Click="OnOk"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
