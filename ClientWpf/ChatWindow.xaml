<Window x:Class="ChatApp.ClientWpf.ChatWindow"
        x:Name="Self"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatApp.ClientWpf"
        Title="Sprout"
        Width="1280" Height="800"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWarm}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
  <Window.Resources>
    <local:InitialsConverter x:Key="Initials"/>
    <local:AvatarBrushConverter x:Key="AvatarBrush"/>
    <local:BoolToVisibilityConverter x:Key="b2v"/>
    <local:InverseBoolToVisibilityConverter x:Key="ib2v"/>
    <local:TimeConverter x:Key="time"/>
    <local:EmptyToCollapsedConverter x:Key="empty2collapse"/>

    <!-- ============================================================
         Chat-list row template (sidebar)
         ============================================================ -->
    <Style x:Key="ChatRowItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bg" CornerRadius="12" Padding="10,8"
                    Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#14FEFAE0"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#28FEFAE0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ChatRowTemplate" DataType="{x:Type local:ChatRowVM}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Avatar -->
        <Grid Grid.Column="0" Width="38" Height="38" HorizontalAlignment="Left">
          <Border CornerRadius="19"
                  Background="{Binding Title, Converter={StaticResource AvatarBrush}}"
                  Visibility="{Binding IsGroup, Converter={StaticResource ib2v}}"/>
          <Border CornerRadius="12"
                  Background="{Binding Title, Converter={StaticResource AvatarBrush}}"
                  Visibility="{Binding IsGroup, Converter={StaticResource b2v}}"/>
          <TextBlock Text="{Binding Title, Converter={StaticResource Initials}}"
                     FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                     FontSize="13"
                     Foreground="{StaticResource Forest}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <!-- Name + preview -->
        <StackPanel Grid.Column="1" Margin="10,1,2,1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}"
                     Foreground="{StaticResource Cream}"
                     FontFamily="{StaticResource DisplayFont}"
                     FontWeight="SemiBold" FontSize="13.5"
                     TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <Path Data="{StaticResource LockGlyph}" Stretch="Uniform"
                  Width="9" Height="9" Margin="0,0,5,0"
                  Fill="#88FEFAE0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Preview}"
                       Foreground="#88FEFAE0" FontSize="11.5"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasPreview, Converter={StaticResource b2v}}"
                       MaxWidth="160"/>
            <TextBlock Text="сообщений ещё нет"
                       Foreground="#66FEFAE0" FontSize="11.5"
                       FontStyle="Italic"
                       Visibility="{Binding HasPreview, Converter={StaticResource ib2v}}"/>
          </StackPanel>
        </StackPanel>
        <!-- Unread badge -->
        <Border Grid.Column="2" VerticalAlignment="Center" Margin="4,0,2,0"
                Visibility="{Binding HasUnread, Converter={StaticResource b2v}}">
          <Border CornerRadius="10" Background="{StaticResource Online}" MinWidth="20" Height="20" Padding="5,0">
            <TextBlock Text="{Binding UnreadLabel}"
                       Foreground="White" FontSize="10.5" FontWeight="Bold"
                       FontFamily="{StaticResource DisplayFont}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- ============================================================
         Message bubble templates (in / out / system)
         ============================================================ -->
    <DataTemplate x:Key="OutgoingBubble" DataType="{x:Type local:BubbleVM}">
      <Grid Margin="0,2,0,2" HorizontalAlignment="Right" MaxWidth="520" Tag="{Binding}">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="↩  Ответить" Click="OnBubbleReply"/>
            <MenuItem Header="⤷  Переслать" Click="OnBubbleForward"/>
            <Separator/>
            <MenuItem Header="Удалить" Click="OnBubbleDelete"/>
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                CornerRadius="18,18,6,18"
                Background="{StaticResource Forest}"
                Padding="14,10"
                HorizontalAlignment="Right"
                Effect="{StaticResource ShadowSmall}">
          <TextBlock Text="{Binding Text}"
                     Foreground="{StaticResource Cream}"
                     FontSize="14" LineHeight="20"
                     TextWrapping="Wrap"/>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,4,0">
          <TextBlock Text="{Binding Time, Converter={StaticResource time}}"
                     Foreground="{StaticResource Sage}" FontSize="10.5"/>
          <Path Margin="6,4,0,0" Width="12" Height="9"
                Stretch="Uniform"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Stroke="{StaticResource Sage}"
                Data="M0,5 L3,8 L8,3 M7,8 L8,9 L14,2"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IncomingBubble" DataType="{x:Type local:BubbleVM}">
      <Grid Margin="0,2,0,2" HorizontalAlignment="Left" MaxWidth="540" Tag="{Binding}">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="↩  Ответить" Click="OnBubbleReply"/>
            <MenuItem Header="⤷  Переслать" Click="OnBubbleForward"/>
            <Separator/>
            <MenuItem Header="Удалить" Click="OnBubbleDelete"/>
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- avatar dot -->
        <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Bottom"
              Visibility="{Binding ShowAvatar, Converter={StaticResource b2v}}">
          <Ellipse Fill="{Binding SenderLabel, Converter={StaticResource AvatarBrush}}"/>
          <TextBlock Text="{Binding SenderLabel, Converter={StaticResource Initials}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                     FontSize="11" Foreground="{StaticResource Forest}"/>
        </Grid>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding SenderLabel}"
                     FontFamily="{StaticResource DisplayFont}"
                     FontWeight="SemiBold" FontSize="11"
                     Foreground="{StaticResource Sage}"
                     Margin="2,0,0,3"
                     Visibility="{Binding ShowSenderLabel, Converter={StaticResource b2v}}"/>
          <Border CornerRadius="18,18,18,6"
                  Background="White"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                  Padding="14,10"
                  Effect="{StaticResource ShadowSmall}">
            <TextBlock Text="{Binding Text}"
                       Foreground="{StaticResource Ink}"
                       FontSize="14" LineHeight="20"
                       TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SystemBubble" DataType="{x:Type local:BubbleVM}">
      <TextBlock Text="{Binding Text}"
                 HorizontalAlignment="Center"
                 Foreground="{StaticResource Sage}"
                 FontStyle="Italic" FontSize="12"
                 Margin="0,6,0,6"/>
    </DataTemplate>

    <local:BubbleTemplateSelector x:Key="BubbleSelector"
                                  Incoming="{StaticResource IncomingBubble}"
                                  Outgoing="{StaticResource OutgoingBubble}"
                                  System="{StaticResource SystemBubble}"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="292"/>  <!-- sidebar -->
      <ColumnDefinition Width="*"/>     <!-- main -->
      <ColumnDefinition Width="320"/>   <!-- right -->
    </Grid.ColumnDefinitions>

    <!-- ============================================================
         SIDEBAR
         ============================================================ -->
    <Border Grid.Column="0" Background="{StaticResource ForestDeep}">
      <DockPanel LastChildFill="True">

        <!-- Brand row -->
        <Border DockPanel.Dock="Top" Padding="14,14,14,10">
          <StackPanel Orientation="Horizontal">
            <Border CornerRadius="12" Width="38" Height="38"
                    Background="{StaticResource SoftGreenBg}"
                    Padding="8">
              <Path Data="{StaticResource SproutLeafGeom}" Stroke="{StaticResource Forest}"
                    StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stretch="Uniform"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sprout"
                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="15" Foreground="{StaticResource Cream}"/>
                <Border Margin="6,2,0,0" CornerRadius="4" Padding="5,1.5"
                        Background="#26FEFAE0" BorderBrush="#5C9CC97A" BorderThickness="1">
                  <TextBlock Text="E2EE" Foreground="{StaticResource SoftGreen}"
                             FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                             FontSize="9"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="OnlineLabel"
                         Text="@you · подключение…"
                         Foreground="#AAFEFAE0" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Search -->
        <Border DockPanel.Dock="Top" Padding="14,4,14,8">
          <TextBox x:Name="TbSearch" Style="{StaticResource SidebarSearchBox}"
                   Tag="Поиск по чатам"
                   TextChanged="OnSearchChanged"/>
        </Border>

        <!-- New chat -->
        <Border DockPanel.Dock="Top" Padding="14,0,14,10">
          <Button x:Name="BtnNewChat"
                  Content="＋  Новый чат"
                  Style="{StaticResource PillowCream}"
                  Height="40"
                  Click="OnNewChat"
                  IsEnabled="False"/>
        </Border>

        <!-- Section header -->
        <TextBlock DockPanel.Dock="Top" Text="ЧАТЫ" Style="{StaticResource SectionHeader}"/>

        <!-- Footer: status + logout -->
        <Border DockPanel.Dock="Bottom" Padding="14,10,14,12" BorderBrush="#22FEFAE0" BorderThickness="0,1,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse Fill="#3D5BAA45"/>
                <Ellipse Width="8" Height="8" Fill="{StaticResource Online}"/>
              </Grid>
              <TextBlock x:Name="StatusFooter" Grid.Column="1"
                         Text="Подключение к серверу…"
                         Foreground="#BBFEFAE0" FontSize="11.5"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Button Content="⬅  Выйти из аккаунта"
                    Style="{StaticResource PillowSidebar}"
                    Height="34" Margin="0,8,0,0"
                    FontSize="11.5"
                    Click="OnLogout"/>
            <Button x:Name="BtnReconnectNow"
                    Content="↺  Подключиться сейчас"
                    Style="{StaticResource PillowSidebar}"
                    Height="34" Margin="0,4,0,0"
                    FontSize="11.5"
                    Visibility="Collapsed"
                    Click="OnReconnectNow"/>
          </StackPanel>
        </Border>

        <!-- Chat list + empty state overlay -->
        <Grid>
          <ListBox x:Name="ChatList"
                   ItemTemplate="{StaticResource ChatRowTemplate}"
                   ItemContainerStyle="{StaticResource ChatRowItem}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   SelectionChanged="OnChatSelected"
                   Padding="2,0,2,8"/>
          <TextBlock x:Name="EmptyChats"
                     Text="Пока нет чатов.&#x0a;Нажмите «＋ Новый чат»."
                     TextAlignment="Center"
                     Foreground="#88FEFAE0"
                     FontStyle="Italic" FontSize="12"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     IsHitTestVisible="False"
                     Visibility="Visible"/>
        </Grid>

      </DockPanel>
    </Border>

    <!-- ============================================================
         CENTER (chat)
         ============================================================ -->
    <DockPanel Grid.Column="1" LastChildFill="True">

      <!-- Header -->
      <Border DockPanel.Dock="Top" Padding="22,12" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
              Background="#E0F6F2E2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
            <!-- avatar -->
            <Grid x:Name="HeaderAvatarHost" Width="42" Height="42" VerticalAlignment="Center"
                  Visibility="{Binding ElementName=Self, Path=HasPeer, Converter={StaticResource b2v}}">
              <Border CornerRadius="21"
                      Background="{Binding ElementName=PeerNameLabel, Path=Text, Converter={StaticResource AvatarBrush}}"
                      Visibility="{Binding ElementName=Self, Path=PeerIsGroup, Converter={StaticResource ib2v}}"/>
              <Border CornerRadius="13"
                      Background="{Binding ElementName=PeerNameLabel, Path=Text, Converter={StaticResource AvatarBrush}}"
                      Visibility="{Binding ElementName=Self, Path=PeerIsGroup, Converter={StaticResource b2v}}"/>
              <TextBlock Text="{Binding ElementName=PeerNameLabel, Path=Text, Converter={StaticResource Initials}}"
                         FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                         Foreground="{StaticResource Forest}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse Width="11" Height="11" Fill="{StaticResource Online}"
                       Stroke="{StaticResource BgWarm}" StrokeThickness="2"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,-1,-1"/>
            </Grid>

            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PeerNameLabel"
                           Text="Выберите чат"
                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="16" Foreground="{StaticResource Ink}"/>
                <Border Margin="8,3,0,0" CornerRadius="5" Padding="7,2"
                        Background="{StaticResource SoftGreenBg}"
                        BorderBrush="#330A400C" BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="{Binding ElementName=Self, Path=HasPeer, Converter={StaticResource b2v}}">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="9" Height="9" Stretch="Uniform"
                          Stroke="{StaticResource Forest}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M2,5 L5,8 L11,2"/>
                    <TextBlock Text="E2EE" Foreground="{StaticResource Forest}"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="9.5" Margin="4,0,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock x:Name="PeerStatusLabel"
                         Text=""
                         Foreground="{StaticResource Sage}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- Right buttons -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnInvite" Content="＋ Пригласить"
                    Style="{StaticResource PillowCream}" Height="36" Padding="14,0"
                    FontSize="12.5" Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="OnInviteToGroup"/>
            <Button x:Name="BtnRoomAction" Content="Удалить"
                    Style="{StaticResource PillowDanger}" Height="36" Padding="14,0"
                    FontSize="12.5"
                    Visibility="Collapsed"
                    Click="OnRoomAction"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Composer -->
      <Border DockPanel.Dock="Bottom" Padding="20,8,20,18" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
        <StackPanel>
          <!-- Reply bar (hidden by default) -->
          <Border x:Name="ReplyBar" Visibility="Collapsed"
                  Background="#EBE6CF" CornerRadius="14" Padding="14,8,10,8"
                  Margin="0,0,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="↩ Ответ"
                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="10.5" Foreground="{StaticResource Forest}"/>
                <TextBlock x:Name="ReplyPreviewText"
                           Foreground="{StaticResource InkSoft}" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1" Content="✕" Click="OnCancelReply"
                      Foreground="{StaticResource Sage}"
                      Background="Transparent" BorderThickness="0"
                      Width="26" Height="26" FontSize="12"
                      Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
          </Border>
          <!-- Main input card -->
          <Border CornerRadius="24" Background="White"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                  Padding="14,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TbInput" Grid.Column="0"
                       Style="{StaticResource ComposerTextBox}"
                       Tag="Напишите сообщение…"
                       VerticalAlignment="Center"
                       IsEnabled="False"
                       KeyDown="OnInputKeyDown"/>
              <Button x:Name="BtnSend" Grid.Column="1"
                      Content="➤  Отправить"
                      Style="{StaticResource PillowPrimary}"
                      Height="40" Padding="18,0"
                      Margin="8,0,0,0"
                      IsEnabled="False"
                      Click="OnSendClick"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Messages -->
      <ScrollViewer x:Name="MessageScroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="22,12,22,10">
        <StackPanel>
          <!-- Encryption banner -->
          <Border CornerRadius="16" Padding="16,10" Margin="60,18,60,16"
                  Background="#80D9F0BC"
                  BorderBrush="#330A400C" BorderThickness="1"
                  HorizontalAlignment="Center"
                  Visibility="{Binding ElementName=Self, Path=HasPeer, Converter={StaticResource b2v}}">
            <StackPanel HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{StaticResource LockGlyph}" Stretch="Uniform"
                      Width="11" Height="11" Fill="{StaticResource Forest}"
                      VerticalAlignment="Center"/>
                <TextBlock Text="Сообщения зашифрованы end-to-end"
                           Foreground="{StaticResource Forest}"
                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="12.5" Margin="7,0,0,0"/>
              </StackPanel>
              <TextBlock Text="Никто, кроме участников чата — даже Sprout — их не прочитает."
                         Foreground="{StaticResource Forest}" FontSize="11.5"
                         HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>

          <!-- Empty state -->
          <StackPanel x:Name="EmptyState" Margin="0,40,0,40" HorizontalAlignment="Center">
            <Border CornerRadius="24" Width="84" Height="84" Background="{StaticResource SoftGreenBg}"
                    HorizontalAlignment="Center" Padding="18">
              <Path Data="{StaticResource SproutLeafGeom}" Stroke="{StaticResource Forest}"
                    StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stretch="Uniform"/>
            </Border>
            <TextBlock x:Name="EmptyTitle" Text="Выберите чат, росток"
                       FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="22" Foreground="{StaticResource Forest}"
                       Margin="0,18,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptySub"
                       Text="Sprout не читает ваши сообщения. Никто не читает.&#x0a;Выберите диалог слева или начните новый."
                       Foreground="{StaticResource InkSoft}" FontSize="13"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>
          </StackPanel>

          <!-- Messages list -->
          <ItemsControl x:Name="MessagesList"
                        ItemTemplateSelector="{StaticResource BubbleSelector}"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ============================================================
         RIGHT PANEL
         ============================================================ -->
    <Border Grid.Column="2" Background="{StaticResource Cream}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0">
      <DockPanel>
        <!-- Tabs -->
        <Border DockPanel.Dock="Top" Padding="18,14,18,10"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Инфо"
                       FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       Foreground="{StaticResource Forest}" FontSize="13"
                       Margin="0,0,16,0"/>
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Profile header -->
            <StackPanel Margin="0,22,0,16" HorizontalAlignment="Center">
              <Grid Width="80" Height="80" HorizontalAlignment="Center"
                    Visibility="{Binding ElementName=Self, Path=HasPeer, Converter={StaticResource b2v}}">
                <Border CornerRadius="40"
                        Background="{Binding ElementName=PeerNameLabel, Path=Text, Converter={StaticResource AvatarBrush}}"
                        Visibility="{Binding ElementName=Self, Path=PeerIsGroup, Converter={StaticResource ib2v}}"/>
                <Border CornerRadius="22"
                        Background="{Binding ElementName=PeerNameLabel, Path=Text, Converter={StaticResource AvatarBrush}}"
                        Visibility="{Binding ElementName=Self, Path=PeerIsGroup, Converter={StaticResource b2v}}"/>
                <TextBlock Text="{Binding ElementName=PeerNameLabel, Path=Text, Converter={StaticResource Initials}}"
                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="26"
                           Foreground="{StaticResource Forest}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="ProfileName"
                         FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                         FontSize="18" Foreground="{StaticResource Ink}"
                         HorizontalAlignment="Center" Margin="0,12,0,0"
                         Text=""/>
              <TextBlock x:Name="ProfileHandle"
                         Foreground="{StaticResource Sage}" FontSize="12"
                         HorizontalAlignment="Center" Margin="0,2,0,0"
                         Text=""/>
            </StackPanel>

            <!-- Encryption card -->
            <Border Margin="14,8,14,12" Padding="16" CornerRadius="18"
                    Background="White" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
              <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border CornerRadius="16" Width="32" Height="32"
                          Background="{StaticResource SoftGreenBg}">
                    <Path Width="14" Height="11" Stretch="Uniform"
                          Stroke="{StaticResource Forest}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M2,6 L6,10 L14,2"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="End-to-end шифрование"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="13" Foreground="{StaticResource Forest}"/>
                    <TextBlock Text="ключ сессии активен"
                               Foreground="{StaticResource Sage}" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource InkSoft}" FontSize="11.5" LineHeight="16"
                           Margin="0,12,0,10"
                           Text="Каждое сообщение и файл шифруются ключами, которые есть только у вас и у собеседника. Сервер их не читает."/>
                <Border CornerRadius="10" Padding="10,8" Background="{StaticResource BgWarm}">
                  <TextBlock x:Name="PeerKeyLabel"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11.5"
                             Foreground="{StaticResource Forest}"
                             TextAlignment="Center"
                             HorizontalAlignment="Center"
                             LineHeight="20"
                             Text="· · · ·   · · · ·   · · · ·   · · · ·"/>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
